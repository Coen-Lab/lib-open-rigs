          <dev:Command>LeftDown</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightUp</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightUp</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightDown</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightDown</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftIn</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftIn</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftOut</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftOut</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightIn</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightIn</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightOut</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightOut</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>BaseLeft</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>BaseLeft</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>BaseRight</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>BaseRight</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SpoutsIn</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="IntProperty">
          <Value>150</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>LickSpoutStage.StepSize</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ControlEvents</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnParameterSet">
          <orcl:Name>SpoutStepSize</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>StepSizeToInt</scr:Name>
        <scr:Expression>Convert.ToInt32(it)</scr:Expression>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>LickSpoutStage.StepSize</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.StepSize</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="StepSize" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:LickSpoutStage">
          <dev:RigFile>UNMAPPED</dev:RigFile>
          <dev:PositionsFile>UNMAPPED</dev:PositionsFile>
          <dev:SubjectId>UNMAPPED</dev:SubjectId>
          <dev:RetractSteps>1500</dev:RetractSteps>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:MoveLickSpoutDriver">
          <dev:Driver>A</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:MoveLickSpoutDriver">
          <dev:Driver>B</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>StepperDriver</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RigDevice">
          <core:Name>StepperDriver-A</core:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>StepperDriver-A</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
        <Name>StepperDriver-A</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>StepperDriver</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RigDevice">
          <core:Name>StepperDriver-B</core:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>StepperDriver-B</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.Data</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
        <Name>StepperDriver-B</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigFile</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>SubjectId</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="SubjectId" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>it.Substring(0, it.LastIndexOf("\\")) + "\\LickSpoutPositions.csv"</scr:Expression>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="PositionsFile" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigFile</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="RigFile" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:AnnounceStage">
          <core:Stage>SpoutsHomed</core:Stage>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>ReadyStages</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.StepSize</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:DelaySubscription">
          <rx:DueTime>PT1S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:ParameterDefault">
          <orcl:Name>SpoutStepSize</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeclareControls">
          <orcl:Piece>LickSpoutStage</orcl:Piece>
          <orcl:Parameters>
            <orcl:Parameter>
              <orcl:Name>SpoutStepSize</orcl:Name>
              <orcl:Value />
              <orcl:Description>Motor steps each spout nudge moves, taken live while ready; until set, 150.</orcl:Description>
              <orcl:Minimum>1</orcl:Minimum>
              <orcl:WholeNumber>true</orcl:WholeNumber>
            </orcl:Parameter>
          </orcl:Parameters>
          <orcl:Commands>
            <orcl:Command>
              <orcl:Name>SpoutsHome</orcl:Name>
              <orcl:Description>Move both spouts to the home position.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>SpoutsIn</orcl:Name>
              <orcl:Description>Move both spouts to the in position.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>SpoutsOut</orcl:Name>
              <orcl:Description>Move both spouts to the out position.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>SpoutsDefault</orcl:Name>
              <orcl:Description>Reset the in position to rig.yml's lickSpoutDefaultPosition and move both spouts there; SaveSpoutPositions keeps it for this mouse.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>SaveSpoutPositions</orcl:Name>
              <orcl:Description>Save the spouts' in positions to this mouse's file.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>LeftUp</orcl:Name>
              <orcl:Description>Nudge the left spout up by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>LeftDown</orcl:Name>
              <orcl:Description>Nudge the left spout down by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>RightUp</orcl:Name>
              <orcl:Description>Nudge the right spout up by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>RightDown</orcl:Name>
              <orcl:Description>Nudge the right spout down by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>LeftIn</orcl:Name>
              <orcl:Description>Nudge the left spout in by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>LeftOut</orcl:Name>
              <orcl:Description>Nudge the left spout out by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>RightIn</orcl:Name>
              <orcl:Description>Nudge the right spout in by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>RightOut</orcl:Name>
              <orcl:Description>Nudge the right spout out by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>BaseLeft</orcl:Name>
              <orcl:Description>Nudge the spout base left by SpoutStepSize.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>BaseRight</orcl:Name>
              <orcl:Description>Nudge the spout base right by SpoutStepSize.</orcl:Description>
            </orcl:Command>
          </orcl:Commands>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionCondition">
        <scr:Expression>Target != null</scr:Expression>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Target</Selector>
      </Expression>
      <Expression xsi:type="scr:ExpressionCondition">
        <scr:Expression>Event != null</scr:Expression>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>new(Event as Event, Detail as Detail)</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orl:CreateEvent" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
        <Name>Timestamp</Name>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>Events</Name>
      </Expression>
    </Nodes>
