<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns:tsg="clr-namespace:Harp.TimestampGeneratorGen3;assembly=Harp.TimestampGeneratorGen3"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The rig's clock from a Harp timestamp generator (Gen3), Name (TimestampGeneratorGen3-&lt;Entry&gt;), from its entry under timestampGeneratorGen3 in rig.yml (RigConfigs); a workflow has exactly one clock. Opens the generator on its portName behind Name.Data and Name.Commands and logs it as Name. Sets its clock to the PC's UTC time, again at each heartbeat until one agrees (SetHarpClock), and writes rig.yml's timerFrequency. Publishes Timestamp (the generator's timer, in Harp seconds) and HarpClockSet (the first Timestamp within 2 s of UTC), and announces HarpClockSet into ReadyStages (HarpClockSet is declared by ReadyGate, before every device, as each device's log waits for it). Stops the workflow, naming the generator, if its clock is not set within 10 s or its heartbeats stop for 3 s.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" Description="The generator's name in the data, TimestampGeneratorGen3-&lt;Entry&gt; such as TimestampGeneratorGen3-Main: its rig.yml entry, its subjects and its folder." />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TimestampGeneratorGen3</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RigDevice">
          <core:Name />
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="CommandsSubjectName" Description="Name.Commands: the subject the generator takes its commands from." />
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="PortName" Selector="Settings.PortName" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="tsg:Device">
          <harp:OperationMode>Active</harp:OperationMode>
          <harp:OperationLed>On</harp:OperationLed>
          <harp:DumpRegisters>true</harp:DumpRegisters>
          <harp:VisualIndicators>On</harp:VisualIndicators>
          <harp:Heartbeat>Enabled</harp:Heartbeat>
          <harp:IgnoreErrors>false</harp:IgnoreErrors>
          <harp:PortName>UNMAPPED</harp:PortName>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="DataSubjectName" Description="Name.Data: the subject the generator's messages are published on." />
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="harp:FilterMessageType">
          <harp:FilterType>Include</harp:FilterType>
          <harp:MessageType>Event</harp:MessageType>
        </Combinator>
      </Expression>
      <Expression xsi:type="tsg:Parse">
        <harp:Register xsi:type="tsg:TimestampedTimer" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Seconds</Selector>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>Timestamp</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Timestamp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HarpClockSet">
          <dev:ToleranceSeconds>2</dev:ToleranceSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>HarpClockSet</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:AnnounceStage">
          <core:Stage>HarpClockSet</core:Stage>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>ReadyStages</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:SetHarpClock">
          <dev:Name />
          <dev:ToleranceSeconds>2</dev:ToleranceSeconds>
          <dev:TimeoutSeconds>10</dev:TimeoutSeconds>
          <dev:GapSeconds>3</dev:GapSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="TimerFrequency" Selector="Settings.TimerFrequency" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="tsg:CreateMessage">
        <harp:MessageType>Write</harp:MessageType>
        <harp:Payload xsi:type="tsg:CreateTimerFrequencyPayload">
          <tsg:TimerFrequency>Timer1000Hz</tsg:TimerFrequency>
        </harp:Payload>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Delay">
          <rx:DueTime>PT0.1S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
        <Name />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="3" Label="Source2" />
      <Edge From="0" To="4" Label="Source2" />
      <Edge From="0" To="7" Label="Source1" />
      <Edge From="0" To="24" Label="Source2" />
      <Edge From="0" To="25" Label="Source1" />
      <Edge From="0" To="32" Label="Source2" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="5" To="9" Label="Source1" />
      <Edge From="5" To="30" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="10" Label="Source2" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="12" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="11" To="13" Label="Source1" />
      <Edge From="11" To="23" Label="Source1" />
      <Edge From="11" To="31" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="19" To="20" Label="Source1" />
      <Edge From="20" To="21" Label="Source1" />
      <Edge From="21" To="22" Label="Source1" />
      <Edge From="23" To="24" Label="Source1" />
      <Edge From="24" To="29" Label="Source1" />
      <Edge From="25" To="26" Label="Source1" />
      <Edge From="26" To="27" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
      <Edge From="28" To="29" Label="Source2" />
      <Edge From="29" To="30" Label="Source1" />
      <Edge From="31" To="32" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
