<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common hardware and control functionality for all Open Rigs experiments.</Description>
    <PackageTags>$(PackageTags) Devices</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.62</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <!-- rig.yml read untyped, as Core reads it: wiring for WiredOutput. -->
  <ItemGroup>
    <Compile Include="..\Shared\RigDevices.cs" Link="Shared\RigDevices.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Arduino" />
    <PackageReference Include="Bonsai.Core" />
    <PackageReference Include="Harp.Behavior" />
    <PackageReference Include="Harp.StepperDriver" />
    <PackageReference Include="Harp.TimestampGeneratorGen3" />
    <PackageReference Include="AllenNeuralDynamics.LicketySplit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
    <PackageReference Include="Harp.Hobgoblin" />
  </ItemGroup>

</Project>
