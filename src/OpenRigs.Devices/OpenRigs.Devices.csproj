<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common hardware and control functionality for all Open Rigs experiments.</Description>
    <PackageTags>$(PackageTags) Devices</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <!-- rig.yml read untyped, as Core reads it: wiring for WiredOutput. -->
  <ItemGroup>
    <Compile Include="..\Shared\RigDevices.cs" Link="Shared\RigDevices.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Arduino"   Version="2.9.0" />
    <PackageReference Include="Bonsai.Core"      Version="2.9.0" />
    <PackageReference Include="Harp.Behavior" Version="0.2.0" />
    <PackageReference Include="Harp.StepperDriver" Version="0.4.0" />
    <PackageReference Include="Harp.TimestampGeneratorGen3" Version="0.1.1" />
    <PackageReference Include="AllenNeuralDynamics.LicketySplit" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
    <ProjectReference Include="..\OpenRigs.Control\OpenRigs.Control.csproj" />
    <ProjectReference Include="..\OpenRigs.Logging\OpenRigs.Logging.csproj" />
    <PackageReference Include="Harp.Hobgoblin" Version="0.1.2" />
  </ItemGroup>

</Project>
