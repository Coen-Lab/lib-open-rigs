<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns:p1="clr-namespace:AllenNeuralDynamics.LicketySplit;assembly=AllenNeuralDynamics.LicketySplit"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>One Lickety Split lick detector, Name (LicketySplit-&lt;Entry&gt;), from its entry under licketySplit in rig.yml (RigConfigs): asks the board WhoAmI and, if it is silent, flushes its stuck command parser (FlushPicoHarp; the workflow stops if it is still silent), publishes the entry as the AsyncSubject Name, opens the device on its portName behind Name.Data and Name.Commands, writes each channel 0 threshold its entry sets (channel0TriggerThreshold, channel0UntriggerThreshold) at its first message, and none the entry leaves out, so the board keeps its own, publishes the lick state (true while a lick is detected) on LickStateSubjectName, and logs the device as Name once the experiment folder exists and the Harp clock is set. Stops the workflow at start, naming the entries rig.yml has, if rig.yml has no entry by that name.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" Description="The device's name in the data, LicketySplit-&lt;Entry&gt; such as LicketySplit-Left: its rig.yml entry, its subjects and its folder." />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>LicketySplit</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RigDevice">
          <core:Name />
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="CommandsSubjectName" Description="Name.Commands: the subject the device takes its commands from." />
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="PortName" Selector="Settings.PortName" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:Device">
          <harp:OperationMode>Active</harp:OperationMode>
          <harp:OperationLed>On</harp:OperationLed>
          <harp:DumpRegisters>true</harp:DumpRegisters>
          <harp:VisualIndicators>On</harp:VisualIndicators>
          <harp:Heartbeat>Enabled</harp:Heartbeat>
          <harp:IgnoreErrors>false</harp:IgnoreErrors>
          <harp:PortName>UNMAPPED</harp:PortName>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="DataSubjectName" Description="Name.Data: the subject the device's messages are published on." />
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>TriggerThresholdSet</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Settings.Channel0TriggerThreshold.HasValue</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Channel0TriggerThreshold" Selector="Item2.Settings.Channel0TriggerThreshold.Value" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="p1:CreateMessage">
        <harp:MessageType>Write</harp:MessageType>
        <harp:Payload xsi:type="p1:CreateChannel0TriggerThresholdPayload">
          <p1:Channel0TriggerThreshold>0</p1:Channel0TriggerThreshold>
        </harp:Payload>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>UntriggerThresholdSet</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Settings.Channel0UntriggerThreshold.HasValue</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Channel0UntriggerThreshold" Selector="Item2.Settings.Channel0UntriggerThreshold.Value" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="p1:CreateMessage">
        <harp:MessageType>Write</harp:MessageType>
        <harp:Payload xsi:type="p1:CreateChannel0UntriggerThresholdPayload">
          <p1:Channel0UntriggerThreshold>0</p1:Channel0UntriggerThreshold>
        </harp:Payload>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="p1:Parse">
        <harp:Register xsi:type="p1:LickState" />
      </Expression>
      <Expression xsi:type="Equal">
        <Operand xsi:type="WorkflowProperty" TypeArguments="p1:LickChannels">
          <Value>Channel0</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="LickStateSubjectName" Description="The subject that carries the lick state whenever it changes, true while a lick is detected, such as LickStateLeft." Category="Subjects" />
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:FlushPicoHarp" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="3" Label="Source2" />
      <Edge From="0" To="4" Label="Source2" />
      <Edge From="0" To="7" Label="Source1" />
      <Edge From="0" To="15" Label="Source1" />
      <Edge From="0" To="20" Label="Source1" />
      <Edge From="0" To="33" Label="Source2" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="34" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="5" To="9" Label="Source1" />
      <Edge From="5" To="26" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="10" Label="Source2" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="12" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="11" To="13" Label="Source1" />
      <Edge From="11" To="27" Label="Source1" />
      <Edge From="11" To="32" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="17" Label="Source1" />
      <Edge From="14" To="22" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="17" Label="Source2" />
      <Edge From="17" To="18" Label="Source1" />
      <Edge From="17" To="19" Label="Source1" />
      <Edge From="18" To="19" Label="Source2" />
      <Edge From="19" To="25" Label="Source1" />
      <Edge From="20" To="21" Label="Source1" />
      <Edge From="21" To="22" Label="Source2" />
      <Edge From="22" To="23" Label="Source1" />
      <Edge From="22" To="24" Label="Source1" />
      <Edge From="23" To="24" Label="Source2" />
      <Edge From="24" To="25" Label="Source2" />
      <Edge From="25" To="26" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
      <Edge From="28" To="29" Label="Source1" />
      <Edge From="29" To="31" Label="Source1" />
      <Edge From="30" To="31" Label="Source2" />
      <Edge From="32" To="33" Label="Source1" />
      <Edge From="34" To="4" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
