<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:vid="clr-namespace:OpenRigs.Video;assembly=OpenRigs.Video"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The camera triggers of the Behavior board Board, once per workflow that has a camera: opens the board's CameraTriggerController with rig.yml's cameraTriggerController (trigger0Enabled, trigger0Frequency, trigger1Enabled, trigger1Frequency), and starts the enabled triggers (StartCameras) once every camera CamerasExpected names has begun acquiring (CamerasOpen, from each SpinnakerCamera), as a camera drops a trigger that comes before. Stops the workflow, naming the cameras that never opened, if they have not all opened 60 s after Start. The triggers are never stopped: a Stop ends the workflow at once.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="Board" Description="The Behavior board whose camera triggers drive the cameras, such as BehaviorBoard-Main." />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="EnableTrigger0" Selector="Settings.CameraTriggerController.Trigger0Enabled" />
          <Property Name="EnableTrigger1" Selector="Settings.CameraTriggerController.Trigger1Enabled" />
          <Property Name="Trigger0Frequency" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
          <Property Name="Trigger1Frequency" Selector="Settings.CameraTriggerController.Trigger1Frequency" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="BehaviorCommandsSubjectName" DisplayName="BoardCommandsSubjectName" Description="Board.Commands: the subject the board takes its commands from." />
        <Property Name="BehaviorEventsSubjectName" DisplayName="BoardDataSubjectName" Description="Board.Data: the subject the board's messages are published on." />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.CameraTriggerController.bonsai">
        <EnableTrigger0>false</EnableTrigger0>
        <EnableTrigger1>false</EnableTrigger1>
        <Trigger0Frequency>0</Trigger0Frequency>
        <Trigger1Frequency>0</Trigger1Frequency>
        <BehaviorCommandsSubjectName />
        <BehaviorEventsSubjectName />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vid:CamerasOpen" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="PieceStages" DisplayName="CamerasExpected" Description="Every camera's Name, comma separated, such as Camera-Face, Camera-Pupil, Camera-Body: the triggers start once all have opened." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:StartupWatchdog">
          <core:PieceStages />
          <core:TimeoutSeconds>60</core:TimeoutSeconds>
          <core:What>Opening the cameras (CameraTriggers' CamerasExpected)</core:What>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:AnnounceStage">
          <core:Stage>CamerasOpen</core:Stage>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StartCameras</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="4" Label="Source1" />
      <Edge From="3" To="4" Label="Source2" />
      <Edge From="5" To="7" Label="Source1" />
      <Edge From="6" To="7" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
