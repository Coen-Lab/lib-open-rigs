<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Zapit for a task, only in an optogenetics experiment: takes the task file (TaskConfig) once and, when its optogenetics.enabled (OptogeneticsSwitch) is true, gives its optogenetics.zapitConditionsPath to ConnectZapit, which connects to rig.yml's Zapit, carries ZapitCommands and ZapitReplies, and stops the workflow on an error reply, no conditions file loaded, a conditions count other than the file's, or a real mouse on a rig without hardware triggering. Publishes the task file's optogenetics.enabled (OptogeneticsSwitch) as the AsyncSubject Optogenetics (OptogeneticsSubjectName), the condition of Zapit's logs in ExperimentManifest's ExpectedFiles (?Optogenetics). A workflow that also includes ConnectForTaskZapitDaq gives each its own switch and this one another subject name. Needs TaskConfig (with TaskParameters.Optogenetics), RigConfigs, SubjectId and ZapitReplies from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>TaskConfig</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>OptogeneticsExperiment?</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Selector" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>TaskParameters.Optogenetics.Enabled</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TaskParameters.Optogenetics.ZapitConditionsPath</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ConnectZapit.bonsai" />
      <Expression xsi:type="SubscribeSubject">
        <Name>TaskConfig</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TaskParameters.Optogenetics.Enabled</Selector>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>Optogenetics</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Selector" DisplayName="OptogeneticsSwitch" Description="The task's bool that turns this Zapit on, a member of TaskConfig: TaskParameters.Optogenetics.Enabled by default; another, such as TaskParameters.Optogenetics.ZapitMatlab, in a workflow that chooses between Zapits per session." />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="OptogeneticsSubjectName" Description="The AsyncSubject the switch is published as, the condition of Zapit's logs in ExpectedFiles: Optogenetics by default; another in a workflow that also includes ConnectForTaskZapitDaq, which publishes Optogenetics itself." />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="8" To="2" Label="Source2" />
      <Edge From="8" To="6" Label="Source2" />
      <Edge From="9" To="7" Label="Source2" />
    </Edges>
  </Workflow>
</WorkflowBuilder>