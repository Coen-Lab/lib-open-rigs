<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:zap="clr-namespace:OpenRigs.Zapit;assembly=OpenRigs.Zapit"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Zapit for a task. Declares Zapit.Commands (a BehaviorSubject of ZapitDaq commands: a task multicasts each trial's Arm into it from a graph per trial, which a PublishSubject would close), Zapit.Events (ZapitDaq's events, a PublishSubject: a trial must not be handed the last trial's Armed) and Zapit.Bank (the bank ZapitDaq loaded last). On a rig whose rig.yml has a zapit block, from launch: opens ZapitDaq on its NI channels (Rigs.Zapit's paths), sample rate, maxTrialSeconds and earlyStopLeadSeconds, carrying Zapit.Commands into it and its events onto Zapit.Events; opens the Zapit camera (ZapitCamera: Camera-Zapit.Data, recorded in an optogenetics experiment); and runs Zapit's setup phase before Go (ZapitSetup, docs/zapit-setup-protocol.md). A rig without one opens neither. Publishes the task file's optogenetics.enabled as the AsyncSubject Optogenetics, the condition of Zapit's files in ExperimentManifest's ExpectedFiles (?Optogenetics). At Go, in an optogenetics experiment, stops the workflow if rig.yml has no zapit block, and checks the loaded bank against the task (ZapitBankForTask: built from its conditions file, holding its laserPowerMw); with no bank loaded the first Arm stops it. Needs TaskConfig (with TaskParameters.Optogenetics), RigConfigs, RigFile, ConfigRoot, ControlEvents, ExperimentGo, Timestamp, PathPrefix and BehaviorBoard-Main from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>TaskConfig</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TaskParameters.Optogenetics.Enabled</Selector>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>Optogenetics</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="zap:ZapitDaqCommand">
        <rx:Name>Zapit.Commands</rx:Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="zap:ZapitDaqEvent">
        <rx:Name>Zapit.Events</rx:Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="zap:ZapitBank">
        <rx:Name>Zapit.Bank</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Zapit</Selector>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>RigHasZapit?</Name>
        <Description>rig.yml has a zapit block.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it != null</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>Zapit</Name>
        <Description>rig.yml's zapit block, once at launch: ZapitDaq, the Zapit camera and the setup phase.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>ZapitRig</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Zapit.Commands</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ZapitRig</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="GalvoXChannel" Selector="GalvoXChannelPath" />
                <Property Name="GalvoYChannel" Selector="GalvoYChannelPath" />
                <Property Name="LaserChannel" Selector="LaserChannelPath" />
                <Property Name="LedChannel" Selector="LedChannelPath" />
                <Property Name="PhotodiodeChannel" Selector="PhotodiodeChannelPath" />
                <Property Name="TriggerTerminal" Selector="TriggerTerminal" />
                <Property Name="SampleRate" Selector="SampleRate" />
                <Property Name="MaxTrialSeconds" Selector="MaxTrialSeconds" />
                <Property Name="EarlyStopLeadSeconds" Selector="EarlyStopLeadSeconds" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="zap:ZapitDaq">
                <zap:Simulated>false</zap:Simulated>
                <zap:GalvoXChannel>UNMAPPED</zap:GalvoXChannel>
                <zap:GalvoYChannel>UNMAPPED</zap:GalvoYChannel>
                <zap:LaserChannel>UNMAPPED</zap:LaserChannel>
                <zap:LedChannel>UNMAPPED</zap:LedChannel>
                <zap:PhotodiodeChannel>UNMAPPED</zap:PhotodiodeChannel>
                <zap:PhotodiodeTerminal>Rse</zap:PhotodiodeTerminal>
                <zap:TriggerTerminal>UNMAPPED</zap:TriggerTerminal>
                <zap:SampleRate>0</zap:SampleRate>
                <zap:MaxTrialSeconds>0</zap:MaxTrialSeconds>
                <zap:EarlyStopLeadSeconds>0</zap:EarlyStopLeadSeconds>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>Zapit.Events</Name>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ZapitCamera.bonsai" />
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ZapitSetup.bonsai" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="2" To="5" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TaskConfig</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>OptogeneticsExperiment?</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>TaskParameters.Optogenetics.Enabled</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>ZapitAtGo</Name>
        <Description>At Go in an optogenetics experiment: the rig must have Zapit, and the loaded bank must be the task's.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2.Zapit</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="core:RequireValue">
                <core:Message>The task file turns optogenetics on, but this rig's rig.yml has no zapit block: turn optogenetics off, or run on a rig with Zapit.</core:Message>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Zapit.Bank</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>TaskParameters.Optogenetics.ZapitConditionsPath</Selector>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>Convert.ToDouble(TaskParameters.Optogenetics.LaserPowerMw)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="zap:ZapitBankForTask" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="2" Label="Source1" />
            <Edge From="1" To="2" Label="Source2" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="0" To="6" Label="Source1" />
            <Edge From="0" To="7" Label="Source1" />
            <Edge From="5" To="8" Label="Source1" />
            <Edge From="6" To="8" Label="Source2" />
            <Edge From="7" To="8" Label="Source3" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
