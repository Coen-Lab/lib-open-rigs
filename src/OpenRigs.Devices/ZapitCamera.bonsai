<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:pyl="clr-namespace:Bonsai.Pylon;assembly=Bonsai.Pylon"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The Zapit camera, Camera-Zapit, inside ConnectForTaskZapitDaq's Zapit group (ZapitRig, rig.yml's zapit block): stock Bonsai.Pylon PylonCapture with zapit.camera's serialNumber and its session settings file (sessionPfsPath, relative to rig.yml's folder: ResolveRigFile stops the workflow at start on a full path or no file). Each frame (Image, and ChunkData of the grab's ID and camera timestamp, as FfmpegVideoWriter reads it) is stamped with the latest Harp time (WithLatestTimestamp) and published on Camera-Zapit.Data, which StreamDevices streams as the camera Zapit and ZapitSetup saves stills from. In an optogenetics experiment, once the experiment folder exists (PathPrefix), the frames are recorded as Camera-Zapit (LogVideoFfmpeg) at the frequency of the board trigger whose wiring line names Camera-Zapit in targets (CameraTriggerLine: the workflow stops at start without exactly one). Needs ZapitRig, RigFile, ConfigRoot, Timestamp, PathPrefix, Optogenetics, BehaviorBoard-Main and BehaviorBoard-Main.Data from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>ZapitRig</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Camera.SerialNumber</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigFile</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ZapitRig</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Camera.SessionPfsPath</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ResolveRigFile">
          <core:Directory />
          <core:Setting>zapit.camera.sessionPfsPath</core:Setting>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="SerialNumber" Selector="Item1" />
          <Property Name="ParameterFile" Selector="Item2" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="pyl:PylonCapture">
          <pyl:SerialNumber>UNMAPPED</pyl:SerialNumber>
          <pyl:ParameterFile>UNMAPPED</pyl:ParameterFile>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>new(Image as Image, new(GrabResult.ID as FrameID, GrabResult.Timestamp as Timestamp) as ChunkData)</scr:Expression>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
        <Name>Timestamp</Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Camera-Zapit.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>BehaviorBoard-Main</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:CameraTriggerLine">
          <dev:Camera>Camera-Zapit</dev:Camera>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Camera-Zapit.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>PathPrefix</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Optogenetics</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>RecordZapit?</Name>
        <Description>An optogenetics experiment, its folder made.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2</Selector>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="FrameRate" Selector="Item2" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ConfigRoot</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="ConfigRoot" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogVideoFfmpeg.bonsai">
        <Name>Camera-Zapit</Name>
        <FrameRate>50</FrameRate>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="2" To="5" Label="Source1" />
      <Edge From="4" To="5" Label="Source2" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="1" To="7" Label="Source1" />
      <Edge From="6" To="7" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="16" To="18" Label="Source1" />
      <Edge From="17" To="18" Label="Source2" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="15" To="20" Label="Source1" />
      <Edge From="19" To="20" Label="Source2" />
      <Edge From="14" To="21" Label="Source1" />
      <Edge From="22" To="23" Label="Source1" />
      <Edge From="20" To="24" Label="Source1" />
      <Edge From="21" To="24" Label="Source2" />
      <Edge From="23" To="24" Label="Source3" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
