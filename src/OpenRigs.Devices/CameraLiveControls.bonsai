<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns:vid="clr-namespace:OpenRigs.Video;assembly=OpenRigs.Video"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Optional live controls for one SpinnakerCamera piece, Camera, included once per camera: two experiment parameters the piece declares itself for its camera (DeclareDeviceControls, the piece its camera), Camera.ExposureUs (us) and Camera.GainDb (dB), such as Camera-Overhead.ExposureUs, so the workflow declares neither, each taken straight to the open camera when the controller sets it (OnDeviceParameterSet, CameraLiveSetting), so the preview shows the change while ready; Go fixes them. One second after Start, once the controller's server is up, shows rig.yml's exposureTime and gain as the parameters' values (DeviceParameterDefault) and limits a set exposure to the camera's trigger period less 1000 us (DeviceParameterMaximum), so a longer one is refused at the controller instead of stopping the workflow. Board is the camera's board, for its trigger.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="Camera" Description="The camera piece's Name, such as Camera-Overhead." />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Name" DisplayName="Board" Description="The camera's Behavior board, such as BehaviorBoard-Main." />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ControlEvents</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnDeviceParameterSet">
          <orcl:Name />
          <orcl:Parameter>ExposureUs</orcl:Parameter>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>Convert.ToDouble(it)</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vid:CameraLiveSetting">
          <vid:Name />
          <vid:Setting>ExposureTime</vid:Setting>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ControlEvents</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnDeviceParameterSet">
          <orcl:Name />
          <orcl:Parameter>GainDb</orcl:Parameter>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>Convert.ToDouble(it)</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vid:CameraLiveSetting">
          <vid:Name />
          <vid:Setting>Gain</vid:Setting>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:DelaySubscription">
          <rx:DueTime>PT1S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:CameraTrigger">
          <dev:MarginMicroseconds>1000</dev:MarginMicroseconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Camera.Settings.ExposureTime</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeviceParameterDefault">
          <orcl:Name />
          <orcl:Parameter>ExposureUs</orcl:Parameter>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Camera.Settings.Gain</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeviceParameterDefault">
          <orcl:Name />
          <orcl:Parameter>GainDb</orcl:Parameter>
        </Combinator>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>ExposureLimit</scr:Name>
        <scr:Description>The longest exposure that fits the trigger period, less CameraTrigger's 1000 us margin.</scr:Description>
        <scr:Expression>1000000.0 / Frequency - 1000.0</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeviceParameterMaximum">
          <orcl:Name />
          <orcl:Parameter>ExposureUs</orcl:Parameter>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeclareDeviceControls">
          <orcl:Name />
          <orcl:Parameters>
            <orcl:Parameter>
              <orcl:Name>ExposureUs</orcl:Name>
              <orcl:Value />
              <orcl:Description>Camera exposure in microseconds, taken by the camera live until Go. Starts at rig.yml's; at most the trigger period less 1,000.</orcl:Description>
              <orcl:Minimum>100</orcl:Minimum>
            </orcl:Parameter>
            <orcl:Parameter>
              <orcl:Name>GainDb</orcl:Name>
              <orcl:Value />
              <orcl:Description>Camera gain in dB, 0 to 48 (wide enough for every lab camera's own range; a value above a camera's own maximum is refused by the camera), taken by the camera live until Go. Starts at rig.yml's.</orcl:Description>
              <orcl:Minimum>0</orcl:Minimum>
              <orcl:Maximum>48</orcl:Maximum>
            </orcl:Parameter>
          </orcl:Parameters>
          <orcl:Commands />
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="5" Label="Source2" />
      <Edge From="0" To="9" Label="Source2" />
      <Edge From="0" To="10" Label="Source1" />
      <Edge From="0" To="3" Label="Source2" />
      <Edge From="0" To="7" Label="Source2" />
      <Edge From="0" To="16" Label="Source2" />
      <Edge From="0" To="18" Label="Source2" />
      <Edge From="0" To="20" Label="Source2" />
      <Edge From="0" To="21" Label="Source1" />
      <Edge From="1" To="11" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="10" To="12" Label="Source1" />
      <Edge From="11" To="12" Label="Source2" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
      <Edge From="14" To="17" Label="Source1" />
      <Edge From="14" To="19" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="17" To="18" Label="Source1" />
      <Edge From="19" To="20" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
