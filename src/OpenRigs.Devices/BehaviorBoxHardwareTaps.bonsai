<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>BehaviorBoxHardware's devices as a preflight's ticks: each piece's data (its Name.Data), each through PreflightTap into DeviceTicks, which PreflightChecks declares, so a preflight on BehaviorBoxHardware names no device itself. After PreflightChecks.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>BehaviorBoard-Main.Data</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:PreflightTap">
          <dev:Device>BehaviorBoard-Main</dev:Device>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>DeviceTicks</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Camera-Overhead.Data</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:PreflightTap">
          <dev:Device>Camera-Overhead</dev:Device>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>DeviceTicks</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
