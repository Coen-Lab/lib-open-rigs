<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:step="clr-namespace:Harp.StepperDriver;assembly=Harp.StepperDriver"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns:dev="clr-namespace:OpenRigs.Devices;assembly=OpenRigs.Devices"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The two-driver lick spout stage: opens StepperDriver-A and StepperDriver-B (rig.yml entries, subscribed by those names) behind their .Data and .Commands subjects, sets them up, homes all five motors (LickSpoutStage.Homed once done, then the spouts go in), and moves the stage for the controller's spout commands and for LickSpoutCommand values sent to LickSpoutStage.Commands. Each target is published on LickSpoutStage.Target. The mouse's in positions come from PositionsFile, else rig.yml's lickSpoutDefaultPosition (RigFile). The workflow declares the commands: SpoutsHome, SpoutsIn, SpoutsOut, SaveSpoutPositions, LeftUp, LeftDown, RightUp, RightDown, LeftFront, LeftBack, RightFront, RightBack, BaseLeft, BaseRight.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name>StepperDriver-A.Commands</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="PortName" Selector="Settings.PortName" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="step:Device">
          <harp:OperationMode>Active</harp:OperationMode>
          <harp:OperationLed>On</harp:OperationLed>
          <harp:DumpRegisters>true</harp:DumpRegisters>
          <harp:VisualIndicators>On</harp:VisualIndicators>
          <harp:Heartbeat>Enabled</harp:Heartbeat>
          <harp:IgnoreErrors>false</harp:IgnoreErrors>
          <harp:PortName>UNMAPPED</harp:PortName>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>20</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:TakeLast">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:SetUpLickSpoutDriver">
          <dev:Driver>A</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>StepperDriver-A.SetUp</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name>StepperDriver-B.Commands</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="PortName" Selector="Settings.PortName" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="step:Device">
          <harp:OperationMode>Active</harp:OperationMode>
          <harp:OperationLed>On</harp:OperationLed>
          <harp:DumpRegisters>true</harp:DumpRegisters>
          <harp:VisualIndicators>On</harp:VisualIndicators>
          <harp:Heartbeat>Enabled</harp:Heartbeat>
          <harp:IgnoreErrors>false</harp:IgnoreErrors>
          <harp:PortName>UNMAPPED</harp:PortName>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>StepperDriver-B.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.Data</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>20</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:TakeLast">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:SetUpLickSpoutDriver">
          <dev:Driver>B</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>StepperDriver-B.SetUp</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.SetUp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HomeLickSpoutMotor">
          <dev:Driver>A</dev:Driver>
          <dev:Motor>0</dev:Motor>
          <dev:TimeoutSeconds>60</dev:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.SetUp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HomeLickSpoutMotor">
          <dev:Driver>A</dev:Driver>
          <dev:Motor>1</dev:Motor>
          <dev:TimeoutSeconds>60</dev:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-A.SetUp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HomeLickSpoutMotor">
          <dev:Driver>A</dev:Driver>
          <dev:Motor>2</dev:Motor>
          <dev:TimeoutSeconds>60</dev:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.SetUp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HomeLickSpoutMotor">
          <dev:Driver>B</dev:Driver>
          <dev:Motor>0</dev:Motor>
          <dev:TimeoutSeconds>60</dev:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.Data</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StepperDriver-B.SetUp</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:HomeLickSpoutMotor">
          <dev:Driver>B</dev:Driver>
          <dev:Motor>1</dev:Motor>
          <dev:TimeoutSeconds>60</dev:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Last" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Delay">
          <rx:DueTime>PT2S</rx:DueTime>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="dev:LickSpoutCommand">
        <rx:Name>LickSpoutStage.Commands</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ControlEvents</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>SpoutsHome</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SpoutsHome</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>SpoutsIn</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SpoutsIn</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>SpoutsOut</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SpoutsOut</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>SaveSpoutPositions</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SaveSpoutPositions</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftUp</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftUp</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftDown</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftDown</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightUp</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightUp</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightDown</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightDown</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftFront</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftFront</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>LeftBack</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>LeftBack</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightFront</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightFront</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RightBack</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>RightBack</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>BaseLeft</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>BaseLeft</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>BaseRight</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>BaseRight</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:ToLickSpoutCommand">
          <dev:Command>SpoutsIn</dev:Command>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Homed</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="RigFile" />
        <Property Name="PositionsFile" />
        <Property Name="StepSize" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:LickSpoutStage">
          <dev:RigFile>UNMAPPED</dev:RigFile>
          <dev:PositionsFile>UNMAPPED</dev:PositionsFile>
          <dev:StepSize>150</dev:StepSize>
          <dev:RetractSteps>1500</dev:RetractSteps>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:MoveLickSpoutDriver">
          <dev:Driver>A</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-A.Commands</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>LickSpoutStage.Target</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dev:MoveLickSpoutDriver">
          <dev:Driver>B</dev:Driver>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>StepperDriver-B.Commands</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="1" To="4" Label="Source1" />
      <Edge From="3" To="4" Label="Source2" />
