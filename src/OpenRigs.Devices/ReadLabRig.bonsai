<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:rigs="clr-namespace:OpenRigs.Devices.Rigs;assembly=OpenRigs.Devices"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The workflow's rig configuration, once per workflow: reads this machine's rig.yml, whatever the rig, into the lab rig model (LabRig, every part optional) once at start, from ConfigRoot\MachineName\rig.yml. Publishes ConfigRoot (for every other reader of the machine's configuration, such as a camera's video encoder), RigConfigDirectory (the folder holding rig.yml and its calibration files), RigFile (rig.yml's path) and RigConfigs (the LabRig, which each device piece takes its entry from), and outputs the LabRig. Stops the workflow at start if the folder or rig.yml is missing, or rig.yml has a key the model lacks.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Value" DisplayName="ConfigRoot" Description="The root under which each machine has its own configuration directory, ConfigRoot\MachineName\rig.yml." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>C:\Coen-Lab-Local\RigConfigs</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>ConfigRoot</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ConfigRoot</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="ConfigRoot" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ResolveRigConfigDirectory">
          <core:ConfigRoot>UNMAPPED</core:ConfigRoot>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>RigConfigDirectory</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Core:ReadRigConfig.bonsai">
        <FileName>rig.yml</FileName>
      </Expression>
      <Expression xsi:type="rigs:DeserializeFromYaml">
        <rigs:Type xsi:type="TypeMapping" TypeArguments="rigs:LabRig" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigDirectory</Name>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Expression>it + "\\rig.yml"</scr:Expression>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>RigFile</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
