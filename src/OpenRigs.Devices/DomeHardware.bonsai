<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The hardware of a two-spout rig with a lick spout stage, projector and speakers (every such rig has the same devices and names in rig.yml), as device pieces after the workflow's own ReadLabRig (which every workflow includes once, before this: a piece's log waits for PathPrefix, whose ExperimentLogs reads RigConfigs, so RigConfigs defined in here would be defined in terms of itself): the Ready gate (ReadyGate), the clock (TimestampGeneratorGen3-Main), the Behavior board BehaviorBoard-Main with its pulsed reward lines, Zapit trigger line and running wheel (WheelDistanceCm), the lick detectors LicketySplit-Left and -Right (LickStateLeft, LickStateRight), the lick spout stage (StepperDriver-A and -B), and the cameras Camera-Face, Camera-Pupil, Camera-Body on the board's camera triggers, the speakers and their mixer (OpenRigs.Audio SpeakerMixer: Speakers, the four sound subjects) and the projector (OpenRigs.Vision ProjectorDisplay from rig.yml's projector; stimuli draw on DrawStimuli; DisplayDevice). Every task on these rigs has background noise and a screen, so both are the rig's, not the task's. Ready waits for the Harp clock, each Harp device's clock agreeing with it (HarpClockAgrees: the board, both lick detectors and both stage drivers), the spouts homed, each camera's first frame and the mixer started, and for the workflow's own stages (WorkflowStages, each announced by the workflow itself, such as a calibration's CalibrationReady). Each piece takes its entry from rig.yml, logs itself and stops the workflow at start, naming itself, if rig.yml lacks it. Needs OpenRigs.Audio, OpenRigs.Vision and Bonsai.Mixer in the workflow's environment, and ExperimentControl in the workflow (HarpClockAgrees reads its ExperimentGo: a device's clock off the rig's stops the workflow before Go and only warns after it).</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DisplayDevice" Description="The display the projector is on." />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadyGate.bonsai">
        <PieceStages>HarpClockSet, PulsesEnabled, SpoutsHomed, Camera-Face, Camera-Pupil, Camera-Body, MixerStarted, BehaviorBoard-Main, LicketySplit-Left, LicketySplit-Right, StepperDriver-A, StepperDriver-B</PieceStages>
        <WorkflowStages />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ClockFromTimestampGenerator.bonsai">
        <Name>TimestampGeneratorGen3-Main</Name>
        <CommandsSubjectName>TimestampGeneratorGen3-Main.Commands</CommandsSubjectName>
        <DataSubjectName>TimestampGeneratorGen3-Main.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:BehaviorBoard.bonsai">
        <Name>BehaviorBoard-Main</Name>
        <CommandsSubjectName>BehaviorBoard-Main.Commands</CommandsSubjectName>
        <DataSubjectName>BehaviorBoard-Main.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:PulseOutputs.bonsai">
        <Board>BehaviorBoard-Main</Board>
        <BoardCommandsSubjectName>BehaviorBoard-Main.Commands</BoardCommandsSubjectName>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <BoardTriggerCalibratedPulseSubjectName>BehaviorBoard-Main.TriggerCalibratedPulse</BoardTriggerCalibratedPulseSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ZapitTriggerLine.bonsai">
        <Board>BehaviorBoard-Main</Board>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:RunningWheel.bonsai">
        <Board>BehaviorBoard-Main</Board>
        <BoardCommandsSubjectName>BehaviorBoard-Main.Commands</BoardCommandsSubjectName>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <WheelDistanceSubjectName>WheelDistanceCm</WheelDistanceSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LicketySplit.bonsai">
        <Name>LicketySplit-Left</Name>
        <CommandsSubjectName>LicketySplit-Left.Commands</CommandsSubjectName>
        <DataSubjectName>LicketySplit-Left.Data</DataSubjectName>
        <LickStateSubjectName>LickStateLeft</LickStateSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LicketySplit.bonsai">
        <Name>LicketySplit-Right</Name>
        <CommandsSubjectName>LicketySplit-Right.Commands</CommandsSubjectName>
        <DataSubjectName>LicketySplit-Right.Data</DataSubjectName>
        <LickStateSubjectName>LickStateRight</LickStateSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LickSpoutStage.bonsai" />
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:SpinnakerCamera.bonsai">
        <Name>Camera-Face</Name>
        <Board>BehaviorBoard-Main</Board>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <DataSubjectName>Camera-Face.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:SpinnakerCamera.bonsai">
        <Name>Camera-Pupil</Name>
        <Board>BehaviorBoard-Main</Board>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <DataSubjectName>Camera-Pupil.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:SpinnakerCamera.bonsai">
        <Name>Camera-Body</Name>
        <Board>BehaviorBoard-Main</Board>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <DataSubjectName>Camera-Body.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:CameraTriggers.bonsai">
        <Board>BehaviorBoard-Main</Board>
        <BoardCommandsSubjectName>BehaviorBoard-Main.Commands</BoardCommandsSubjectName>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <CamerasExpected>Camera-Face, Camera-Pupil, Camera-Body</CamerasExpected>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Audio:SpeakerMixer.bonsai" />
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Projector</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Vision:ProjectorDisplay.bonsai">
        <DisplayDevice>First</DisplayDevice>
        <WindowState>Fullscreen</WindowState>
        <Width>1920</Width>
        <Height>1080</Height>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="WorkflowStages" Description="The workflow's own stages Ready also waits for, comma separated, each announced by the workflow itself (AnnounceStage into ReadyStages), such as CalibrationReady. Empty for a workflow whose Ready waits only for its pieces." />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:HarpClockAgrees.bonsai">
        <Device>BehaviorBoard-Main</Device>
        <DeviceDataSubjectName>BehaviorBoard-Main.Data</DeviceDataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:HarpClockAgrees.bonsai">
        <Device>LicketySplit-Left</Device>
        <DeviceDataSubjectName>LicketySplit-Left.Data</DeviceDataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:HarpClockAgrees.bonsai">
        <Device>LicketySplit-Right</Device>
        <DeviceDataSubjectName>LicketySplit-Right.Data</DeviceDataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:HarpClockAgrees.bonsai">
        <Device>StepperDriver-A</Device>
        <DeviceDataSubjectName>StepperDriver-A.Data</DeviceDataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:HarpClockAgrees.bonsai">
        <Device>StepperDriver-B</Device>
        <DeviceDataSubjectName>StepperDriver-B.Data</DeviceDataSubjectName>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="17" Label="Source2" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="18" To="1" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
