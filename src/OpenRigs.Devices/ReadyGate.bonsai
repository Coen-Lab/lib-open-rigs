<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The rig's Ready gate, once per workflow: declares ReadyStages, the ReplaySubject each device piece announces its stage into (OpenRigs.Core AnnounceStage, which never completes it), reports Ready to the controller (OpenRigs.Control ReportPhase) once every stage ReadyWaitsFor names has come, and then publishes Ready, the AsyncSubject a task waits on. Stops the workflow, naming the stages that never came, if that takes longer than 180 s from Start (the lick spout stage homes its five motors together, each within 60 s).</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:ReplaySubject" TypeArguments="sys:String">
        <rx:Name>ReadyStages</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ReadyStages</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Expected" DisplayName="ReadyWaitsFor" Description="The stages Ready waits for, comma separated: every stage the workflow's pieces announce, such as HarpClockSet, SpoutsHomed, MixerStarted, Camera-Face." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:StartupWatchdog">
          <core:Expected />
          <core:TimeoutSeconds>180</core:TimeoutSeconds>
          <core:What>Readying the rig (the stages ReadyGate's ReadyWaitsFor names)</core:What>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:ReportPhase">
          <orcl:Phase>Ready</orcl:Phase>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>Ready</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
