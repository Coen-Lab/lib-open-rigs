<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:orcl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The manual rewards, the same in every task: the controller's RewardLeft and RewardRight commands (declared by this piece, DeclareControls, never by the workflow) each send (side, 2.5) into RewardRequests, a 2.5 ul drop at that side through its valve's calibration (BehaviorBoard.DeliverReward), before and during a run. Included by BehaviorBoard.Rewards, which declares RewardRequests; needs ControlEvents from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>ControlEvents</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RewardLeft</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>left</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="DoubleProperty">
          <Value>2.5</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>RewardRequests</Name>
      </Expression>      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:OnCommand">
          <orcl:Name>RewardRight</orcl:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>right</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="DoubleProperty">
          <Value>2.5</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>RewardRequests</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="orcl:DeclareControls">
          <orcl:Piece>ManualRewards</orcl:Piece>
          <orcl:Parameters />
          <orcl:Commands>
            <orcl:Command>
              <orcl:Name>RewardLeft</orcl:Name>
              <orcl:Description>Give 2.5 ul on the left spout, through its valve's calibration.</orcl:Description>
            </orcl:Command>
            <orcl:Command>
              <orcl:Name>RewardRight</orcl:Name>
              <orcl:Description>Give 2.5 ul on the right spout, through its valve's calibration.</orcl:Description>
            </orcl:Command>
          </orcl:Commands>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="2" To="4" Label="Source1" />
      <Edge From="3" To="4" Label="Source2" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="0" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="9" Label="Source1" />
      <Edge From="8" To="9" Label="Source2" />
      <Edge From="9" To="10" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>