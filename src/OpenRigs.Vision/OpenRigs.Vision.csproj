<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common visual stimulus functionality for all Open Rigs experiments.</Description>
    <PackageTags>$(PackageTags) Vision</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-zapit-native.29</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BonVision" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
    <!-- PlayPenaltyFlash.bonsai checks the flashes (OpenRigs.Trials CheckPenaltyFlashes) against the penalty sound (OpenRigs.Audio PenaltySoundSeconds). -->
    <ProjectReference Include="..\OpenRigs.Trials\OpenRigs.Trials.csproj" />
    <ProjectReference Include="..\OpenRigs.Audio\OpenRigs.Audio.csproj" />
  </ItemGroup>

</Project>
