<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:vis="clr-namespace:OpenRigs.Vision;assembly=OpenRigs.Vision"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>A projector's display: a BonVision window on DisplayDevice (created once the whole workflow has subscribed, as ProjectorWindow's is) with an orthographic view of azimuth -135 to 135 and elevation -22.5 to 82.5 degrees, then mesh mapping and gamma correction from the input (rig.yml's projector: meshPath, gammaPath, each relative to rig.yml's folder, the RigFile subject, as calibration/Projector-Mesh.csv). Stimuli draw on the DrawStimuli subject. Stops the workflow at start, saying so, if the input is null (rig.yml has no projector), either path is a full path or names no file (ResolveRigFile), or DisplayDevice is not a display on this machine (RequireDisplay). Disposed on the render thread (DisposeOnRenderThread), so stopping from another thread cannot crash Bonsai. RawProjectorDisplay is the same window without the two corrections. The window, DrawStimuli and the corrections are one group of two branches, with no output: fed from ProjectorWindow's output across an include, the corrections left the window never created, with no error.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="FileName" Selector="Item1" />
          <Property Name="GammaLut" Selector="Item2" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DisplayDevice" Description="The display the projector is on." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>CorrectedWindow</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="DisplayDevice" />
              <Property Name="WindowState" />
              <Property Name="Width" />
              <Property Name="Height" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="gl:CreateWindow">
                <gl:Width>1920</gl:Width>
                <gl:Height>1080</gl:Height>
                <gl:VSync>On</gl:VSync>
                <gl:SwapSync>false</gl:SwapSync>
                <gl:ClearColor>Gray</gl:ClearColor>
                <gl:ClearMask>DepthBufferBit ColorBufferBit</gl:ClearMask>
                <gl:CursorVisible>false</gl:CursorVisible>
                <gl:Location xsi:nil="true" />
                <gl:WindowBorder>Fixed</gl:WindowBorder>
                <gl:WindowState>Fullscreen</gl:WindowState>
                <gl:DisplayDevice>First</gl:DisplayDevice>
                <gl:TargetRenderFrequency>60</gl:TargetRenderFrequency>
                <gl:TargetUpdateFrequency>60</gl:TargetUpdateFrequency>
                <gl:RenderState />
                <gl:GraphicsMode>
                  <gl:ColorFormat>
                    <gl:Red>8</gl:Red>
                    <gl:Green>8</gl:Green>
                    <gl:Blue>8</gl:Blue>
                    <gl:Alpha>8</gl:Alpha>
                  </gl:ColorFormat>
                  <gl:Depth>16</gl:Depth>
                  <gl:Stencil>0</gl:Stencil>
                  <gl:Samples>0</gl:Samples>
                  <gl:AccumulatorFormat>
                    <gl:Red>0</gl:Red>
                    <gl:Green>0</gl:Green>
                    <gl:Blue>0</gl:Blue>
                    <gl:Alpha>0</gl:Alpha>
                  </gl:AccumulatorFormat>
                  <gl:Buffers>2</gl:Buffers>
                  <gl:Stereo>false</gl:Stereo>
                </gl:GraphicsMode>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeOn">
                <rx:Scheduler>CurrentThreadScheduler</rx:Scheduler>
              </Combinator>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.BonVisionResources.bonsai" />
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="res:LoadResources" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="gl:RenderFrame" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.OrthographicView.bonsai">
              <Left>-135</Left>
              <Right>135</Right>
              <Bottom>-22.5</Bottom>
              <Top>82.5</Top>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>DrawStimuli</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="FileName" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.MeshMapping.bonsai">
              <ClearColor>Gray</ClearColor>
              <FileName>UNMAPPED</FileName>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="GammaLut" />
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.GammaCorrection.bonsai">
              <ClearColor>Gray</ClearColor>
              <GammaLut>UNMAPPED</GammaLut>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="9" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="9" To="11" Label="Source1" />
            <Edge From="10" To="11" Label="Source2" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vis:DisposeOnRenderThread">
          <vis:TimeoutSeconds>2</vis:TimeoutSeconds>
        </Combinator>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RequireValue">
          <core:Message>rig.yml has no projector (meshPath, gammaPath), which ProjectorDisplay needs: calibrate the projector first.</core:Message>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="WindowState" Description="Fullscreen for the projector; Normal to test on a desk." />
        <Property Name="Width" Description="The window width, in pixels: the display mode set at start when full screen." />
        <Property Name="Height" Description="The window height, in pixels: the display mode set at start when full screen." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="vis:RequireDisplay">
          <vis:DisplayDevice>First</vis:DisplayDevice>
          <vis:Name>ProjectorDisplay</vis:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigFile</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>MeshPath</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ResolveRigFile">
          <core:Directory />
          <core:Setting>projector.meshPath</core:Setting>
        </Combinator>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigFile</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>GammaPath</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ResolveRigFile">
          <core:Directory />
          <core:Setting>projector.gammaPath</core:Setting>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="6" Label="Source1" />
      <Edge From="6" To="10" Label="Source1" />
      <Edge From="6" To="14" Label="Source1" />
      <Edge From="9" To="11" Label="Source1" />
      <Edge From="10" To="11" Label="Source2" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="13" To="15" Label="Source1" />
      <Edge From="14" To="15" Label="Source2" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="12" To="17" Label="Source1" />
      <Edge From="16" To="17" Label="Source2" />
      <Edge From="17" To="1" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="7" To="3" Label="Source3" />
      <Edge From="3" To="8" Label="Source1" />
      <Edge From="2" To="8" Label="Source2" />
      <Edge From="8" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>