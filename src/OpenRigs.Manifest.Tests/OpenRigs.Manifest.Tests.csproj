<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console harness, not a test framework: it runs on a rig with
       nothing installed but the .NET SDK: dotnet run (two dashes)project src\OpenRigs.Manifest.Tests -->
  <!-- An XML comment cannot hold two dashes in a row, hence the words above. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Manifest\OpenRigs.Manifest.csproj" />
    <!-- Not a dependency of the package: the tests run a real ControlState, which the manifest reads by name. -->
    <ProjectReference Include="..\OpenRigs.Control\OpenRigs.Control.csproj" />
    <!-- Not a dependency of the package: a real Harp package, whose register map is expected only once it is loaded. -->
    <PackageReference Include="Harp.Behavior" Version="0.2.0" />
  </ItemGroup>

</Project>
