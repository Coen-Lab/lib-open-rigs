<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenRigs Logging Bonsai library.</Description>
    <PackageTags>$(PackageTags) Logging</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.5</Version>
  </PropertyGroup>


  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Harp" Version="3.6.1" />
    <PackageReference Include="Bonsai.Spinnaker" Version="0.9.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- rig.yml's cameras, read as OpenRigs.LiveView reads its devices: UsbCamera never takes the rig's own. -->
  <ItemGroup>
    <Compile Include="..\Shared\RigDevices.cs" Link="Shared\RigDevices.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
  </ItemGroup>

</Project>
