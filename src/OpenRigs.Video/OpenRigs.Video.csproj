<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenRigs Logging Bonsai library.</Description>
    <PackageTags>$(PackageTags) Logging</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.0-bbox.3</Version>
  </PropertyGroup>


  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Harp" Version="3.6.1" />
    <PackageReference Include="Bonsai.Spinnaker" Version="0.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
  </ItemGroup>

</Project>
