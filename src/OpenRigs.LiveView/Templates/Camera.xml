<?xml version="1.0" encoding="utf-8"?>
<!-- A camera: the image found in its data (by type), sampled, shrunk and JPEG-encoded by
     OpenRigs.Streaming's PackVideoMessage, on the video port. -->
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>{{Subject}}</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>{{ImagePath}}</Selector>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Streaming:PackVideoMessage.bonsai">
        <SampleInterval>{{Interval}}</SampleInterval>
        <FrameSize>
          <Width>{{Width}}</Width>
          <Height>{{Height}}</Height>
        </FrameSize>
        <Interpolation>Linear</Interpolation>
        <StreamName>{{Stream}}</StreamName>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
