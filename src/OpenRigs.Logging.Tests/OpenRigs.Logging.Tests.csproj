<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <!-- Pulls in the native OpenCV binaries used to generate and inspect test videos -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Test workflows are launched from disk by the Bonsai CLI rather than embedded -->
  <ItemGroup>
    <None Update="**\*.bonsai" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- Matches the version in the Bonsai environment, since the output directory is also its lib path -->
    <PackageReference Include="OpenCV.Net" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Logging\OpenRigs.Logging.csproj" />
    <!-- TaskLogs includes Zapit's logs (OpenRigs.Devices ZapitLogs) -->
    <ProjectReference Include="..\OpenRigs.Devices\OpenRigs.Devices.csproj" />
    <!-- TaskLogsZapitDaq and ConditionedTaskLogsZapitDaq (the ZapitDaq adapter's) log ZapitDaq's events (OpenRigs.Zapit) -->
    <ProjectReference Include="..\OpenRigs.Zapit\OpenRigs.Zapit.csproj" />
    <ProjectReference Include="..\OpenRigs.Opto.ZapitDaq\OpenRigs.Opto.ZapitDaq.csproj" />
    <ProjectReference Include="..\OpenRigs.Tests\OpenRigs.Tests.csproj" />
  </ItemGroup>

</Project>
