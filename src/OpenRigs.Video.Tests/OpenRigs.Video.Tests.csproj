<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <Nullable>disable</Nullable>
    <!-- Pulls in the native OpenCV binaries the test frames are made with -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Workflows run from disk by headless Bonsai, with this output directory as its lib path -->
  <ItemGroup>
    <None Update="**\*.bonsai" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.3" />
    <!-- The ExpressionTransform OpenRigs.Devices' TriggeredSpinnaker include makes its frames with -->
    <PackageReference Include="Bonsai.Scripting.Expressions" Version="2.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Video\OpenRigs.Video.csproj" />
    <!-- LogVideoFfmpeg.bonsai, built here with the writer -->
    <ProjectReference Include="..\OpenRigs.Logging\OpenRigs.Logging.csproj" />
    <!-- BonsaiWorkflowRunner, for the headless runs -->
    <ProjectReference Include="..\OpenRigs.Tests\OpenRigs.Tests.csproj" />
  </ItemGroup>

</Project>
