<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:v="clr-namespace:OpenRigs.Video;assembly=OpenRigs.Video"
                 xmlns:t="clr-namespace:OpenRigs.Video.Tests;assembly=OpenRigs.Video.Tests"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Count" DisplayName="FrameCount" />
        <Property Name="Width" />
        <Property Name="Height" />
        <Property Name="Channels" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="t:SyntheticFrames">
          <t:Count>3</t:Count>
          <t:Width>320</t:Width>
          <t:Height>240</t:Height>
          <t:Channels>1</t:Channels>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="FileName" />
        <Property Name="ConfigRoot" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="v:FfmpegVideoWriter">
          <v:FileName />
          <v:FrameRate>50</v:FrameRate>
          <v:ConfigRoot>C:\nowhere</v:ConfigRoot>
        </Combinator>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Count" DisplayName="TakeCount" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1000000</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="5" Label="Source1" />
      <Edge From="4" To="5" Label="Source2" />
      <Edge From="5" To="6" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
