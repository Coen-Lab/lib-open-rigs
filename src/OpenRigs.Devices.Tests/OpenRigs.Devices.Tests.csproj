<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472</TargetFrameworks>
    <Nullable>disable</Nullable>
    <!-- Pulls in the native OpenCV binaries ProjectorDisplay's gamma image loads with -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <!-- PiecesSubscribeTests: each piece built and subscribed here, so every assembly its workflow names -->
  <ItemGroup>
    <None Update="Pieces\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- ZapitSetupTests: OpenRigs.Zapit.Tests' contract bank -->
    <None Include="..\OpenRigs.Zapit.Tests\Data\Settings_ZapitBank_T.json;..\OpenRigs.Zapit.Tests\Data\Settings_ZapitBank_T.bin.gz" Link="Pieces\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Scripting.Expressions" />
    <PackageReference Include="Bonsai.Mixer" />
    <!-- ZapitLiveViewTests: ConnectForTaskZapitDaq's camera, ZapitDaq and StreamDevices -->
    <PackageReference Include="Bonsai.Pylon" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Devices\OpenRigs.Devices.csproj" />
    <ProjectReference Include="..\OpenRigs.Video\OpenRigs.Video.csproj" />
    <ProjectReference Include="..\OpenRigs.Logging\OpenRigs.Logging.csproj" />
    <ProjectReference Include="..\OpenRigs.Audio\OpenRigs.Audio.csproj" />
    <ProjectReference Include="..\OpenRigs.Vision\OpenRigs.Vision.csproj" />
    <ProjectReference Include="..\OpenRigs.Control\OpenRigs.Control.csproj" />
    <ProjectReference Include="..\OpenRigs.Zapit\OpenRigs.Zapit.csproj" />
    <!-- WorkflowConfigRootTests: the nodes that read rig.yml when the workflow is built -->
    <ProjectReference Include="..\OpenRigs.LiveView\OpenRigs.LiveView.csproj" />
    <ProjectReference Include="..\OpenRigs.Streaming\OpenRigs.Streaming.csproj" />
    <ProjectReference Include="..\OpenRigs.HarpDevices\OpenRigs.HarpDevices.csproj" />
    <ProjectReference Include="..\OpenRigs.Manifest\OpenRigs.Manifest.csproj" />
  </ItemGroup>

</Project>
