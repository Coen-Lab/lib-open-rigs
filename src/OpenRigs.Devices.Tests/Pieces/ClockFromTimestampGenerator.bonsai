<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The timestamp generator clock. PiecesSubscribeTests sets ConfigRoot; PathPrefix never comes, so nothing is logged.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadLabRig.bonsai">
        <ConfigRoot>CONFIG_ROOT</ConfigRoot>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
        <rx:Name>PathPrefix</rx:Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadyGate.bonsai">
        <ReadyWaitsFor>HarpClockSet</ReadyWaitsFor>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ClockFromTimestampGenerator.bonsai">
        <Name>TimestampGeneratorGen3-Main</Name>
        <CommandsSubjectName>TimestampGeneratorGen3-Main.Commands</CommandsSubjectName>
        <DataSubjectName>TimestampGeneratorGen3-Main.Data</DataSubjectName>
      </Expression>
    </Nodes>
    <Edges>
    </Edges>
  </Workflow>
</WorkflowBuilder>
