<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>One camera and its triggers, on a stand-in board (its subjects only, no port). PiecesSubscribeTests sets ConfigRoot; PathPrefix never comes, so nothing is logged.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadLabRig.bonsai">
        <ConfigRoot>CONFIG_ROOT</ConfigRoot>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
        <rx:Name>PathPrefix</rx:Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadyGate.bonsai">
        <PieceStages>Camera-Face</PieceStages>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>BehaviorBoard</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:RigDevice">
          <core:Name>BehaviorBoard-Main</core:Name>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>BehaviorBoard-Main</Name>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name>BehaviorBoard-Main.Commands</rx:Name>
      </Expression>
      <Expression xsi:type="rx:PublishSubject" TypeArguments="harp:HarpMessage">
        <rx:Name>BehaviorBoard-Main.Data</rx:Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:SpinnakerCamera.bonsai">
        <Name>Camera-Face</Name>
        <Board>BehaviorBoard-Main</Board>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <DataSubjectName>Camera-Face.Data</DataSubjectName>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:CameraTriggers.bonsai">
        <Board>BehaviorBoard-Main</Board>
        <BoardCommandsSubjectName>BehaviorBoard-Main.Commands</BoardCommandsSubjectName>
        <BoardDataSubjectName>BehaviorBoard-Main.Data</BoardDataSubjectName>
        <CamerasExpected>Camera-Face</CamerasExpected>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
