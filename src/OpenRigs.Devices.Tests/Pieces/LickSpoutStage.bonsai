<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:ctl="clr-namespace:OpenRigs.Control;assembly=OpenRigs.Control"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The lick spout stage. PiecesSubscribeTests sets ConfigRoot; PathPrefix, ControlEvents and SubjectId (ExperimentControl's) never come, so nothing is logged.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadLabRig.bonsai">
        <ConfigRoot>CONFIG_ROOT</ConfigRoot>
      </Expression>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
        <rx:Name>PathPrefix</rx:Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:ReadyGate.bonsai">
        <PieceStages>SpoutsHomed</PieceStages>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Devices:LickSpoutStage.bonsai" />
      <Expression xsi:type="rx:PublishSubject" TypeArguments="ctl:ControlEvent">
        <rx:Name>ControlEvents</rx:Name>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject" TypeArguments="sys:String">
        <rx:Name>SubjectId</rx:Name>
      </Expression>
    </Nodes>
    <Edges>
    </Edges>
  </Workflow>
</WorkflowBuilder>
