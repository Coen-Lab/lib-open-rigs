<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:core="clr-namespace:OpenRigs.Core;assembly=OpenRigs.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>A clock's chain as ClockFromTimestampGenerator has it: a ticking source, Take(1) (HarpClockSet), MulticastSubject into the AsyncSubject HarpClockSet, then AnnounceStage into ReadyStages. The AsyncSubject must complete, so its subscriber stops the workflow with CLOCKSET; if it never does, a 5 s timer stops it with NEVER COMPLETED.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:AsyncSubject" TypeArguments="sys:Int64">
        <rx:Name>HarpClockSet</rx:Name>
      </Expression>
      <Expression xsi:type="rx:ReplaySubject" TypeArguments="sys:String">
        <rx:Name>ReadyStages</rx:Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0.2S</rx:DueTime>
          <rx:Period>PT0.1S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>HarpClockSet</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:AnnounceStage">
          <core:Stage>HarpClockSet</core:Stage>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>ReadyStages</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>HarpClockSet</Name>
      </Expression>
      <Expression xsi:type="Format">
        <Format>CLOCKSET {0}</Format>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ThrowError" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT5S</rx:DueTime>
          <rx:Period>PT0S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Format">
        <Format>HarpClockSet NEVER COMPLETED {0}</Format>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="core:ThrowError" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>