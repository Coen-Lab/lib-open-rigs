<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common classes and types for OpenRigs experiments.</Description>
    <PackageTags>$(PackageTags) Core</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DataSchemas\**" />
    <EmbeddedResource Remove="DataSchemas\**" />
    <None Remove="DataSchemas\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.9.0" />
    <PackageReference Include="Bonsai.Harp" Version="3.6.1" />
    <PackageReference Include="Bonsai.System" Version="2.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="MathNet.Numerics" Version="4.15.0" />
  </ItemGroup>

</Project>