<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A package providing common classes and types for OpenRigs experiments.</Description>
    <PackageTags>$(PackageTags) Core</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.40</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DataSchemas\**" />
    <EmbeddedResource Remove="DataSchemas\**" />
    <None Remove="DataSchemas\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RigDevices.cs" Link="Shared\RigDevices.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- RigConfigDirectory.FilePath: every rig.yml file path relative to its folder, the speakers' too. -->
    <InternalsVisibleTo Include="OpenRigs.Audio" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" />
    <PackageReference Include="Bonsai.Harp" />
    <PackageReference Include="Bonsai.System" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>

</Project>