<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Zapit optostimulation on an NI DAQ: trials concatenated from lib_zapit's bank and armed as finite AO on a trigger line, the scanner and laser calibration steps, and a simulated twin.</Description>
    <PackageTags>$(PackageTags) Zapit</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-zapit-native.14</Version>
  </PropertyGroup>

  <!--
    NationalInstruments.DAQmx is not on NuGet by itself: Bonsai.DAQmx carries it under build/net462/bin/<platform>
    and adds it only for an x86 or x64 Platform. It is referenced from there, never copied; on a rig Bonsai loads it
    through the Bonsai.DAQmx dependency, and it needs the NI-DAQmx runtime (nicaiu.dll) only when a real task runs.
  -->
  <ItemGroup>
    <PackageReference Include="Bonsai.Core" />
    <PackageReference Include="Bonsai.DAQmx" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OpenCV.Net" />
    <Reference Include="NationalInstruments.DAQmx">
      <HintPath>$(PkgBonsai_DAQmx)\build\net462\bin\x64\NationalInstruments.DAQmx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenRigs.Zapit.Tests" />
  </ItemGroup>

</Project>
