<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenRigs Manifest Bonsai library. One node, ExperimentManifest, writes manifest.json into each experiment folder: the rig, the workflow's commit, how it was launched, the settings at Go, the configuration files as loaded at Start, the files it must leave (a folder for each device in rig.yml it publishes), how the run ended and every file. Nothing is wired to it.</Description>
    <PackageTags>$(PackageTags) Manifest Logging</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.13</Version>
    <!-- Every public type and member is documented: the summaries are what the Bonsai editor shows. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- src\OpenRigs.Manifest.Tests drives the writer, which is internal. -->
    <InternalsVisibleTo Include="OpenRigs.Manifest.Tests" />
  </ItemGroup>

  <!-- The workflow's commit, the subjects published and rig.yml's devices, read as
       OpenRigs.LiveView reads them: compiled into both, internal to each. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" Version="2.9.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- device.yml for Harp packages released without one (RegisterMaps.LabCopies). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Shared\RegisterMaps\*.yml" LogicalName="OpenRigs.Shared.RegisterMaps.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
