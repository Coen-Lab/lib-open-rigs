<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>OpenRigs Streaming Bonsai library. Streams live experiment telemetry over ZeroMQ, and receives it on a remote machine.</Description>
    <PackageTags>$(PackageTags) Streaming</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bonsai.Core" />
    <PackageReference Include="Bonsai.Dsp" />
    <PackageReference Include="Bonsai.Scripting.Expressions" />
    <PackageReference Include="Bonsai.Vision" />
    <PackageReference Include="Bonsai.ZeroMQ" />
    <PackageReference Include="NetMQ" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Core\OpenRigs.Core.csproj" />
  </ItemGroup>

</Project>
