<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:orl="clr-namespace:OpenRigs.Logging;assembly=OpenRigs.Logging"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Declares the Events subject and writes every event sent to it into WorkflowData\WorkflowData_Events_&lt;start&gt;.csv, one file for the experiment (LogWorkflowData), as harpTime,Event,Detail,Value: everything of an experiment that is not a trial, such as manual rewards, flushes, spout moves and Zapit's replies (ZapitReply). Events replays, so events sent before the experiment folder exists (before Go) are kept and written once it does. Place LogEvents once, at the top level or in a top-level group and ahead of every sender, never inside a SelectMany. Send events with CreateEvent, then WithLatestTimestamp, then MulticastSubject Events. Each row is flushed to disk as it is written (AutoFlush) and published to LoggedRows (PublishRows), which OpenRigs.LiveView's StreamDevices streams.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:ReplaySubject" TypeArguments="harp:Timestamped(orl:EventRow)">
        <rx:Name>Events</rx:Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>PathPrefix</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogWorkflowData.bonsai">
        <LogName>WorkflowData_Events</LogName>
        <Selector />
        <AutoFlush>true</AutoFlush>
        <PublishRows>true</PublishRows>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="2" Label="Source1" />
      <Edge From="1" To="2" Label="Source2" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
