<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Writes one row per trial into WorkflowData\WorkflowData_Trials_&lt;start&gt;.csv, one file for the experiment (LogWorkflowData): every field of the timestamped trial record, its settings and its outcome together. Build the record once the trial has ended, stamp it last with WithLatestTimestamp, and send it here. Each row is flushed to disk as it is written (AutoFlush) and published to LoggedRows (PublishRows), which OpenRigs.LiveView's StreamDevices streams, so a live view has each trial as it ends.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogWorkflowData.bonsai">
        <LogName>WorkflowData_Trials</LogName>
        <Selector />
        <AutoFlush>true</AutoFlush>
        <PublishRows>true</PublishRows>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
