<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Writes one row per trial into BonsaiData_Trial: every field of the timestamped trial record, its settings and its outcome together. Build the record once the trial has ended, stamp it last with WithLatestTimestamp, and send it here.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
        <ChunkSize>1</ChunkSize>
        <ClosingDuration xsi:nil="true" />
        <LogName>BonsaiData_Trial</LogName>
        <Selector />
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
