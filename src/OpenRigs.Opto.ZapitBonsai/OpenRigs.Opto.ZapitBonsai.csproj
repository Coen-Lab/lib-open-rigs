<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The trial loop's opto adapter for Zapit on an NI DAQ (Zapit-Bonsai, OpenRigs.Zapit): its opto system for OpenRigs.Trials, each trial's Arm, early stop and trigger, the task's connect, setup, camera and log includes, and its Go limits.</Description>
    <PackageTags>$(PackageTags) Opto Zapit</PackageTags>
    <TargetFrameworks>net472</TargetFrameworks>
    <Version>0.1.1-coen-lab.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.bonsai" />
  </ItemGroup>

  <!-- An adapter depends on the trial loop and its own driver, never the reverse. ZapitSetup's controls are OpenRigs.Control's,
       the task logs OpenRigs.Logging's. -->
  <ItemGroup>
    <ProjectReference Include="..\OpenRigs.Trials\OpenRigs.Trials.csproj" />
    <ProjectReference Include="..\OpenRigs.Zapit\OpenRigs.Zapit.csproj" />
    <ProjectReference Include="..\OpenRigs.Devices\OpenRigs.Devices.csproj" />
    <ProjectReference Include="..\OpenRigs.Logging\OpenRigs.Logging.csproj" />
    <ProjectReference Include="..\OpenRigs.Control\OpenRigs.Control.csproj" />
  </ItemGroup>

</Project>
