<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:aud="clr-namespace:OpenRigs.Audio;assembly=OpenRigs.Audio"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>The penalty sound, the same in every task: the lab's one penalty sound (PenaltySoundBuffer, on rig.yml's penaltySoundChannel alone) laid out once the trials' rules are made at Go, at the loudest penalty level any trial draws (TrialRules' LoudestPenaltyLevelDbfs, its peak checked then), into the AsyncSubject PenaltySoundBuffer; each input, a penalised trial's penalty.sound.levelDbfs (NaN when mute: nothing plays), then plays it at that level (SoundAtLevel), sent into SpeakerMixer's PenaltySounds. Needs TrialRules (with LoudestPenaltyLevelDbfs) and Speakers from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>TrialRules</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>LoudestPenaltyLevelDbfs</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Speakers</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="LevelDbfs" Selector="Item1" />
        </PropertyMappings>
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aud:PenaltySoundBuffer">
          <aud:LevelDbfs>-30</aud:LevelDbfs>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>PenaltySoundBuffer</Name>
      </Expression>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>PenaltySoundBuffer</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aud:SoundAtLevel">
          <aud:BufferLevelDbfs>NaN</aud:BufferLevelDbfs>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>PenaltySounds</Name>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="BufferLevelDbfs" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TrialRules</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>LoudestPenaltyLevelDbfs</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="8" To="10" Label="Source1" />
      <Edge From="9" To="10" Label="Source2" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="14" Label="Source1" />
      <Edge From="14" To="11" Label="Source2" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
