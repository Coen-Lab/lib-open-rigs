<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:aud="clr-namespace:OpenRigs.Audio;assembly=OpenRigs.Audio"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>A task's reward tone, in PlayPenaltySound's shape: the tone (RewardToneFile, the task's own mono 32-bit float file, read at Start) laid out once the trials' rules are made at Go on every rig.yml speaker, each copy equalised for its speaker, at the loudest reward tone level any trial draws (TrialRules' LoudestRewardToneLevelDbfs), into the AsyncSubject RewardToneBuffer (SpeakerBuffer stops the workflow if a copy would peak at -1 dBFS); each input, a rewarded trial's rewardTone.levelDbfs (NaN when mute: nothing plays), then plays it at that level (SoundAtLevel), sent into SpeakerMixer's RewardToneSounds. Needs TrialRules (with LoudestRewardToneLevelDbfs) and Speakers from the workflow.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>TrialRules</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>LoudestRewardToneLevelDbfs</Selector>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Speakers</Name>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Path" DisplayName="RewardToneFile" Description="The reward tone: one row of 32-bit floats at the audio device's rate, as stored; relative to the workflow's folder." />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:MatrixReader">
          <dsp:Path>./sounds/reward_tone.bin</dsp:Path>
          <dsp:Offset>0</dsp:Offset>
          <dsp:SampleRate>0</dsp:SampleRate>
          <dsp:ChannelCount>1</dsp:ChannelCount>
          <dsp:BufferLength>0</dsp:BufferLength>
          <dsp:Depth>F32</dsp:Depth>
          <dsp:Layout>RowMajor</dsp:Layout>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="InputMapping">
        <PropertyMappings>
          <Property Name="LevelDbfs" Selector="Item1" />
        </PropertyMappings>
        <Selector>Item2</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aud:SpeakerBuffer">
          <aud:LevelDbfs>-35</aud:LevelDbfs>
          <aud:Equalise>true</aud:Equalise>
          <aud:SyncCopy>false</aud:SyncCopy>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>RewardToneBuffer</Name>
      </Expression>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RewardToneBuffer</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="aud:SoundAtLevel">
          <aud:BufferLevelDbfs>NaN</aud:BufferLevelDbfs>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>RewardToneSounds</Name>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="BufferLevelDbfs" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>TrialRules</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>LoudestRewardToneLevelDbfs</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="2" To="6" Label="Source1" />
      <Edge From="5" To="6" Label="Source2" />
      <Edge From="1" To="7" Label="Source1" />
      <Edge From="6" To="7" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="11" To="13" Label="Source1" />
      <Edge From="12" To="13" Label="Source2" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="14" To="15" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="19" To="17" Label="Source1" />
      <Edge From="17" To="14" Label="Source2" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
